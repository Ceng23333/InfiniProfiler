{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infiniprofiler.dev/schemas/infiniprofiler-profile-2.json",
  "title": "Promotion-grade normalized profile",
  "type": "object",
  "required": [
    "schema_version",
    "capture",
    "window",
    "workload",
    "ranks",
    "timing_attribution",
    "source_map",
    "host_signals",
    "metrics",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "infiniprofiler-profile-2"},
    "capture": {"$ref": "infiniprofiler-profile-1.json#/$defs/capture"},
    "window": {"$ref": "#/$defs/window"},
    "workload": {"$ref": "#/$defs/workload"},
    "ranks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rankView"}},
    "timing_attribution": {"$ref": "infiniprofiler-profile-1.json#/$defs/timingAttribution"},
    "source_map": {"$ref": "#/$defs/sourceMap"},
    "host_signals": {"type": "array", "items": {"$ref": "infiniprofiler-profile-1.json#/$defs/hostSignal"}},
    "metrics": {"type": "array", "items": {"$ref": "infiniprofiler-profile-1.json#/$defs/engineMetric"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "window": {
      "type": "object",
      "required": [
        "window_id",
        "wall_compare_ref",
        "wall_workload_id",
        "client_started_epoch_ns",
        "client_ended_epoch_ns",
        "warmup_excluded",
        "start_skew_ms",
        "duration_ratio",
        "alignment"
      ],
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "wall_compare_ref": {"type": "string", "minLength": 1},
        "wall_workload_id": {"type": "string", "minLength": 1},
        "client_started_epoch_ns": {"type": "integer"},
        "client_ended_epoch_ns": {"type": "integer"},
        "warmup_excluded": {"const": true},
        "start_skew_ms": {"type": "number", "minimum": 0, "maximum": 50},
        "duration_ratio": {"type": "number", "minimum": 0.95, "maximum": 1.05},
        "alignment": {"const": "MATCHED"}
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "campaign_id",
        "model",
        "backend_baseline_pin",
        "backend_candidate_pin",
        "tensor_parallel",
        "concurrency",
        "prompt_lengths",
        "output_lengths",
        "clock_policy",
        "profiles_source_hash"
      ],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "backend_baseline_pin": {"type": "string", "minLength": 1},
        "backend_candidate_pin": {"type": "string", "minLength": 1},
        "tensor_parallel": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 0},
        "prompt_lengths": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "output_lengths": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "batch_size": {"type": "integer", "minimum": 1},
        "clock_policy": {"type": "string", "minLength": 1},
        "profiles_source_hash": {"type": "string", "minLength": 1}
      }
    },
    "rankView": {
      "type": "object",
      "required": [
        "rank",
        "pid",
        "gpu_busy_us",
        "start_epoch_ns",
        "end_epoch_ns",
        "start_skew_us",
        "last_finish_skew_us",
        "straggler_wait_us",
        "tp_imbalance_ratio",
        "correlation_status"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 0},
        "pid": {"type": "integer", "minimum": 1},
        "stream": {"type": "string"},
        "tid": {"type": "integer", "minimum": 0},
        "gpu_busy_us": {"type": "number", "minimum": 0},
        "start_epoch_ns": {"type": "integer"},
        "end_epoch_ns": {"type": "integer"},
        "start_skew_us": {"type": "number", "minimum": 0},
        "last_finish_skew_us": {"type": "number", "minimum": 0},
        "straggler_wait_us": {"type": "number", "minimum": 0},
        "tp_imbalance_ratio": {"type": "number", "minimum": 0},
        "correlation_status": {"enum": ["EXPLICIT", "UNKNOWN"]},
        "granularity": {"type": "string"},
        "boundary_count": {"type": "integer", "minimum": 0},
        "boundary_status": {"enum": ["UNMATCHED", "MATCHED_GRAPH_REPLAY"]}
      }
    },
    "sourceMap": {
      "type": "object",
      "required": ["source_pin", "source_root_hash", "symbols", "providers"],
      "properties": {
        "source_pin": {"type": "string", "minLength": 1},
        "source_root_hash": {"type": "string", "minLength": 1},
        "symbols": {"type": "array", "items": {"type": "object"}},
        "providers": {"type": "array", "items": {"type": "object"}},
        "source_root": {"type": "string"},
        "scanned_file_count": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "array", "items": {"type": "object"}},
        "rules": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
