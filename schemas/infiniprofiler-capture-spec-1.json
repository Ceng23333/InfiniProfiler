{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infiniprofiler.dev/schemas/infiniprofiler-capture-spec-1.json",
  "title": "Transactional hcTracer campaign capture specification",
  "type": "object",
  "required": [
    "schema_version",
    "role",
    "window_id",
    "campaign_id",
    "model",
    "baseline_pin",
    "candidate_pin",
    "tensor_parallel",
    "wall_workload_id",
    "wall_compare_ref",
    "warmup_excluded",
    "client_command",
    "concurrency",
    "prompt_lengths",
    "output_lengths",
    "clock_policy",
    "profiles_source_hash",
    "rank_pids"
  ],
  "properties": {
    "schema_version": {"const": "infiniprofiler-capture-spec-1"},
    "role": {"enum": ["baseline", "candidate"]},
    "window_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "baseline_pin": {"type": "string", "minLength": 1},
    "candidate_pin": {"type": "string", "minLength": 1},
    "tensor_parallel": {"type": "integer", "minimum": 1},
    "wall_workload_id": {"type": "string", "minLength": 1},
    "wall_compare_ref": {"type": "string", "minLength": 1},
    "warmup_excluded": {"const": true},
    "client_command": {"type": "string", "minLength": 1},
    "concurrency": {"type": "integer", "minimum": 0},
    "prompt_lengths": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "output_lengths": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "batch_size": {"type": "integer", "minimum": 1},
    "clock_policy": {"type": "string", "minLength": 1},
    "profiles_source_hash": {"type": "string", "minLength": 1},
    "rank_pids": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1},
      "propertyNames": {"pattern": "^[0-9]+$"}
    }
  }
}
