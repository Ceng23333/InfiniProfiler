{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infiniprofiler.dev/schemas/infiniprofiler-profile-1.json",
  "title": "Shared profile field definitions (legacy id retained for $ref stability)",
  "description": "Document-level profile-1 smoke is retired. This file only hosts shared $defs referenced by profile-2 and normalize outputs.",
  "$defs": {
    "capture": {
      "type": "object",
      "required": ["source", "mode", "provenance"],
      "properties": {
        "source": {"type": "string"},
        "mode": {"type": "string"},
        "pid": {"type": ["integer", "null"]},
        "ranks": {"type": "array", "items": {"type": "integer"}},
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]},
        "provenance": {"type": "object"}
      }
    },
    "hostSignal": {
      "type": "object",
      "required": ["family", "candidate", "source"],
      "properties": {
        "family": {"enum": ["api", "command", "driver", "runtime", "gap", "graph"]},
        "candidate": {"type": "number", "minimum": 0},
        "baseline": {"type": "number", "minimum": 0},
        "ratio": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string"},
        "source": {"type": "string"},
        "note": {"type": ["string", "null"]}
      }
    },
    "engineMetric": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": {"type": "string"},
        "candidate": {"type": "number"},
        "baseline": {"type": "number"},
        "ratio": {"type": "number"},
        "unit": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "timingAttribution": {
      "type": "object",
      "required": [
        "evidence_mode",
        "api_submit_us",
        "gpu_execution_us",
        "launch_latency_us",
        "sync_wait_us",
        "graph_launch_us",
        "graph_replay_device_us",
        "cpu_gap_before_us",
        "cpu_gap_after_us",
        "unpaired_event_count"
      ],
      "properties": {
        "evidence_mode": {"type": "string", "minLength": 1},
        "api_submit_us": {"type": "number", "minimum": 0},
        "gpu_execution_us": {"type": "number", "minimum": 0},
        "launch_latency_us": {"type": "number", "minimum": 0},
        "sync_wait_us": {"type": "number", "minimum": 0},
        "graph_launch_us": {"type": "number", "minimum": 0},
        "graph_replay_device_us": {"type": "number", "minimum": 0},
        "cpu_gap_before_us": {"type": "number", "minimum": 0},
        "cpu_gap_after_us": {"type": "number", "minimum": 0},
        "unpaired_event_count": {"type": "integer", "minimum": 0},
        "paired_event_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
