{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infiniprofiler.dev/schemas/infiniprofiler-capture-manifest-1.json",
  "title": "Transactional hcTracer capture manifest",
  "type": "object",
  "required": ["schema_version", "status", "started_epoch_ns", "ended_epoch_ns", "duration_ns", "spec", "ranks"],
  "properties": {
    "schema_version": {"const": "infiniprofiler-capture-manifest-1"},
    "status": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED_RANK_ATTACH",
        "FAILED_RANK_CAPTURE",
        "CLIENT_WINDOW_FAILED"
      ]
    },
    "started_epoch_ns": {"type": "integer", "minimum": 0},
    "ended_epoch_ns": {"type": "integer", "minimum": 0},
    "duration_ns": {"type": "integer", "minimum": 0},
    "client_returncode": {"type": ["integer", "null"]},
    "detail": {"type": "string"},
    "spec": {"$ref": "infiniprofiler-capture-spec-1.json"},
    "ranks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "pid", "status", "raw_files", "raw_bytes"],
        "properties": {
          "rank": {"type": "integer", "minimum": 0},
          "pid": {"type": "integer", "minimum": 1},
          "status": {
            "enum": [
              "ATTACHING",
              "ATTACHED",
              "SUCCEEDED",
              "FAILED_ATTACH",
              "FAILED_CAPTURE",
              "CLIENT_WINDOW_FAILED",
              "STOPPED_DURING_FAILURE"
            ]
          },
          "returncode": {"type": ["integer", "null"]},
          "raw_files": {"type": "array", "items": {"type": "string"}},
          "raw_bytes": {"type": "integer", "minimum": 0},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
