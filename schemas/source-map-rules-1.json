{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infiniprofiler.dev/schemas/source-map-rules-1.json",
  "title": "Engine-neutral source-map scan rules",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": "source-map-rules-1"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "patterns"],
        "properties": {
          "kind": {
            "enum": ["graph_guard", "provider", "scheduler", "deployment_entrypoint", "symbol"]
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "provider": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
