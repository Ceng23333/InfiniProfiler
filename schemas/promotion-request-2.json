{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infiniprofiler.dev/schemas/promotion-request-2.json",
  "title": "Promotion-grade AutoHelix measure request",
  "type": "object",
  "required": [
    "schema_version",
    "controller",
    "stop_before_promote",
    "campaign",
    "observation",
    "gate",
    "diagnosis",
    "lever_contract",
    "promote",
    "mechanism_check"
  ],
  "properties": {
    "schema_version": {"const": "promotion-request-2"},
    "controller": {"const": "autohelix"},
    "stop_before_promote": {"const": true},
    "campaign": {
      "type": "object",
      "required": [
        "campaign_id",
        "model",
        "host",
        "device_track",
        "baseline_pin",
        "candidate_pin",
        "iteration"
      ]
    },
    "observation": {
      "type": "object",
      "required": ["profile_ref", "window"],
      "properties": {
        "profile_ref": {"type": "string", "minLength": 1},
        "window": {
          "type": "object",
          "required": ["window_id", "alignment"],
          "properties": {
            "window_id": {"type": "string", "minLength": 1},
            "alignment": {"const": "MATCHED"}
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["metric", "surpass_threshold", "profiled_result_can_promote"],
      "properties": {
        "metric": {"const": "unprofiled_primary_wall"},
        "surpass_threshold": {"type": "number", "exclusiveMinimum": 1},
        "profiled_result_can_promote": {"const": false}
      }
    },
    "diagnosis": {
      "type": "object",
      "required": ["top_path", "ranked"],
      "properties": {
        "top_path": {"type": "string", "minLength": 1},
        "ranked": {"type": "array", "minItems": 1}
      }
    },
    "lever_contract": {
      "type": "object",
      "required": [
        "lever_id",
        "top_path",
        "expected_signals",
        "source_files",
        "deployment_files",
        "correctness_gate",
        "rollback",
        "wall_gate"
      ],
      "properties": {
        "lever_id": {"type": "string", "minLength": 1},
        "top_path": {"type": "string", "minLength": 1},
        "expected_signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "direction", "min_ratio"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "direction": {"enum": ["increase", "decrease"]},
              "min_ratio": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        },
        "source_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "deployment_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "correctness_gate": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1},
        "wall_gate": {
          "type": "object",
          "required": ["profiled", "ratio_gt"],
          "properties": {
            "profiled": {"const": false},
            "ratio_gt": {"type": "number", "exclusiveMinimum": 1}
          }
        }
      }
    },
    "promote": {
      "type": "object",
      "required": ["one_path", "may_apply", "must_reobserve_unprofiled"],
      "properties": {
        "one_path": {"type": "string", "minLength": 1},
        "may_apply": {"const": false},
        "must_reobserve_unprofiled": {"const": true}
      }
    },
    "mechanism_check": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "MOVED", "NO_CHANGE", "REGRESSED", "INCONCLUSIVE"]},
        "before_profile_ref": {"type": "string"},
        "after_profile_ref": {"type": "string"},
        "results": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
